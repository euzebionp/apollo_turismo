{
  "name": "apollo-reservas",
  "version": "1.0.0",
  "description": "Plataforma de reservas Apollo Turismo — Cloudflare Workers + D1 + Pix",
  "scripts": {
    "dev": "wrangler dev",
    "typecheck": "tsc -p .",
    "db:migrate:local": "wrangler d1 migrations apply apollo-reservas-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply apollo-reservas-db --remote",
    "db:seed:local": "wrangler d1 execute apollo-reservas-db --local --file=seed/viagem-exemplo.sql",
    "test": "node scripts/teste-e2e.mjs",
    "deploy": "wrangler deploy --env production"
  },
  "license": "ISC",
  "dependencies": {
    "hono": "^4.13.17"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261109.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.159.0"
  },
  "private": true,
  "type": "module"
}
